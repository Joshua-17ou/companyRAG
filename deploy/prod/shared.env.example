# /opt/company-rag/shared/.env —— 生产环境非密钥配置模板
#
# ⚠️ 本文件严禁写入任何密钥（口令 / API Key / Secret）。
#    密钥一律通过 /opt/company-rag/shared/secrets/<name> 文件挂载到容器 /run/secrets/。
#    对照关系见 docker-compose.prod.yml 的 secrets 段与 README 部署手册。
#
# 用法：
#   cp deploy/prod/shared.env.example /opt/company-rag/shared/.env
#   然后替换 <...> 占位符，并 chmod 0640（root:10001）。
#
# 注意：本文件同时被 compose 用作「变量插值」来源，因此 post-receive 必须带
#       --env-file /opt/company-rag/shared/.env 调用，否则 *_IMAGE 解析失败。

# ==================== 镜像版本（由 post-receive 按发布提交 SHA 自动改写） ====================
# 手工回滚时，把下面 6 行改回上一份 env-history 里的 SHA 即可。
APP_IMAGE=company-rag/app:0000000000000000000000000000000000000000
FRONTEND_IMAGE=company-rag/frontend:0000000000000000000000000000000000000000
POSTGRES_IMAGE=company-rag/postgres:0000000000000000000000000000000000000000
REDIS_IMAGE=company-rag/redis:0000000000000000000000000000000000000000
QDRANT_IMAGE=company-rag/qdrant:0000000000000000000000000000000000000000
MINIO_IMAGE=company-rag/minio:0000000000000000000000000000000000000000

# ==================== 对外端口（唯一监听的端口，仅绑 127.0.0.1） ====================
# 取值要求：不得使用 443 / 80 / 8888 / 5432 / 55432，且需与网关站点配置保持一致。
UPSTREAM_PORT=18080

# ==================== 服务互联（容器名即主机名） ====================
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=rag_documents
MINIO_URL=http://minio:9000
MINIO_CONSOLE_URL=http://minio:9001
# MINIO_ACCESS_KEY 由 compose 从 MINIO_ROOT_USER 注入，此处不要重复定义
MINIO_BUCKET=knowledge-base
# MinIO 账号名（口令来自 secrets/minio_root_password）
MINIO_ROOT_USER=<minio-access-key>

# ==================== 应用 ====================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
# 应用账号（口令来自 secrets/db_app_password）由 entrypoint_prod.sh 组装成 DATABASE_URL，
# 因此本文件不要定义 DATABASE_URL，避免明文口令落盘。

# ==================== LLM ====================
# DEEPSEEK_API_KEY 来自 secrets/deepseek_api_key
LLM_PROVIDER=deepseek
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ANSWER_MAX_TOKENS=4096
ANSWER_TIMEOUT_SECONDS=90

EMBEDDING_MODEL=BAAI/bge-small-zh
RERANK_MODEL_PATH=/app/models/reranker/models/BAAI--bge-reranker-base/snapshots/master
# 模型已离线预置在 /opt/company-rag/shared/models，禁止运行期联网下载
HF_HOME=/app/models/embeddings
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ==================== 功能开关 ====================
ENABLE_RERANK=true
ENABLE_AUDIT_LOG=true
ENABLE_CACHE=true

RAG_AGENT_ENABLED=false
RAG_AGENT_DEFAULT_MODE=simple
RAG_AGENT_MAX_RETRIEVAL_ATTEMPTS=2
RAG_AGENT_RECOVERY_TOP_K=6
RAG_AGENT_MIN_RESULTS=1
RAG_AGENT_CLARIFY_ON_MISSING_HOSPITAL=true

# ==================== PDF OCR ====================
PDF_OCR_ENABLED=true
PDF_OCR_LANG=ch
PDF_OCR_DPI=200
PDF_OCR_MIN_CONFIDENCE=0.0
PDF_SCANNED_MIN_CHARS=50
PDF_MAX_UPLOAD_MB=200

# ==================== 飞书免登（本环境唯一对外形态，必须开启） ====================
LARK_ENABLED=true
LARK_APP_ID=<飞书应用 App ID>
# LARK_APP_SECRET 来自 secrets/lark_app_secret
# 必须与飞书后台「安全设置 - 重定向 URL」逐字一致（含 https 与路径）
LARK_REDIRECT_URI=https://rag.ganlan.online/auth/callback
LARK_DEFAULT_DEPT=全员
# 生产必须为 true（登录态 Cookie 仅走 HTTPS）
COOKIE_SECURE=true
# LARK_JWT_SECRET 来自 secrets/lark_jwt_secret
LARK_JWT_ALGORITHM=HS256
LARK_JWT_EXPIRE_MINUTES=1440