#!/bin/bash
#
# 裸仓库 post-receive 钩子（安装到 /opt/company-rag/repo/company-rag.git/hooks/post-receive）
#
# 「git push production main」是唯一的发布入口（规范禁止手工 docker compose 部署）。
#
# 执行顺序：
#   1. 解析推送的 commit SHA，并检出到 /opt/company-rag/current
#   2. 校验该 SHA 的 6 个镜像已在生产机就位（离线包需先 docker load）
#   3. 改写 shared/.env 的 *_IMAGE 为本次 SHA（旧值留档，回滚即改回）
#   4. 起基础设施 → 建角色 → 跑迁移 → 起 app/frontend
#   5. 轮询 127.0.0.1:${UPSTREAM_PORT}/ready，失败则自动回滚环境文件并重新 up
#
set -euo pipefail

BASE_DIR="${BASE_DIR:-/opt/company-rag}"
BARE_REPO="${BARE_REPO:-${BASE_DIR}/repo/company-rag.git}"
WORKTREE="${WORKTREE:-${BASE_DIR}/current}"
SHARED_ENV="${SHARED_ENV:-${BASE_DIR}/shared/.env}"
LOG_DIR="${LOG_DIR:-${BASE_DIR}/shared/logs}"
COMPOSE_FILE="${COMPOSE_FILE:-${WORKTREE}/docker-compose.prod.yml}"

READY_TIMEOUT="${READY_TIMEOUT:-600}"
READY_INTERVAL=5

IMAGE_KEYS=(APP_IMAGE FRONTEND_IMAGE POSTGRES_IMAGE REDIS_IMAGE QDRANT_IMAGE MINIO_IMAGE)

mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/deploy-$(date +%Y%m%d_%H%M%S).log"
exec > >(tee -a "${LOG_FILE}") 2>&1

log() { echo "[$(date +%H:%M:%S)] $*"; }

# 串行化：同机不允许并发发布
exec 9>"${LOG_DIR}/deploy.lock"
if ! flock -n 9; then
    echo "❌ 已有发布在运行，本次推送未部署。请稍后重试。" >&2
    exit 1
fi

read_env() {
    # 变量不存在时返回空串而不是让 pipefail 终止脚本
    grep -E "^$1=" "${SHARED_ENV}" 2>/dev/null | tail -n 1 | cut -d= -f2- || true
}

dc() {
    docker compose --env-file "${SHARED_ENV}" -f "${COMPOSE_FILE}" "$@"
}

wait_for_postgres() {
    log "等待 postgres 就绪..."
    for _ in $(seq 1 60); do
        if dc exec -T postgres pg_isready -U admin -d knowledge_base >/dev/null 2>&1; then
            log "postgres 已就绪"
            return 0
        fi
        sleep 2
    done
    log "❌ postgres 超时未就绪"
    return 1
}

deploy() {
    local newrev="$1"
    local old_env_backup=""

    log "=========== 开始发布 ${newrev} ==========="

    if ! [[ "${newrev}" =~ ^[0-9a-f]{40}$ ]]; then
        log "❌ 提交 SHA 不是 40 位小写十六进制，拒绝发布：${newrev}"
        return 1
    fi

    # ---------- 1. 检出代码 ----------
    mkdir -p "${WORKTREE}"
    log "检出代码到 ${WORKTREE}"
    git --git-dir="${BARE_REPO}" --work-tree="${WORKTREE}" checkout -f -q "${newrev}"
    [ -f "${COMPOSE_FILE}" ] || { log "❌ 检出后缺少 ${COMPOSE_FILE}"; return 1; }

    # ---------- 2. 校验镜像就位 ----------
    local missing=0 key ref
    log "检查镜像是否已加载到本机"
    for key in "${IMAGE_KEYS[@]}"; do
        ref="$(read_env "${key}")"
        if [ -z "${ref}" ]; then
            log "  ✗ shared/.env 缺少变量 ${key}"
            missing=1
            continue
        fi
        ref="${ref%:*}:${newrev}"
        if docker image inspect "${ref}" >/dev/null 2>&1; then
            log "  ✓ ${ref}"
        else
            log "  ✗ 缺少镜像 ${ref}"
            missing=1
        fi
    done
    if [ "${missing}" -ne 0 ]; then
        log "❌ 镜像不完整，发布中止。请先在构建机生成离线包并在本机执行："
        log "     docker load -i company-rag-images-${newrev}.tar"
        return 1
    fi

    # ---------- 3. 改写 shared/.env ----------
    old_env_backup="${SHARED_ENV}.bak.$(date +%Y%m%d_%H%M%S)"
    cp -p "${SHARED_ENV}" "${old_env_backup}"
    for key in "${IMAGE_KEYS[@]}"; do
        local old_ref new_ref
        old_ref="$(read_env "${key}")"
        new_ref="${old_ref%:*}:${newrev}"
        if grep -qE "^${key}=" "${SHARED_ENV}"; then
            sed -i "s|^${key}=.*|${key}=${new_ref}|" "${SHARED_ENV}"
        else
            echo "${key}=${new_ref}" >> "${SHARED_ENV}"
        fi
        log "  ${key} = ${new_ref}"
    done
    log "环境文件已备份到 ${old_env_backup}"

    if [ -z "$(read_env UPSTREAM_PORT)" ]; then
        log "❌ shared/.env 缺少 UPSTREAM_PORT，回滚环境文件"
        cp -p "${old_env_backup}" "${SHARED_ENV}"
        return 1
    fi

    # ---------- 4. 基础设施 ----------
    log "启动基础设施"
    if ! dc up -d --remove-orphans postgres redis qdrant minio; then
        log "❌ 基础设施启动失败，回滚环境文件"
        cp -p "${old_env_backup}" "${SHARED_ENV}"
        return 1
    fi
    if ! wait_for_postgres; then
        cp -p "${old_env_backup}" "${SHARED_ENV}"
        return 1
    fi

    # ---------- 5. 角色与迁移 ----------
    log "校正数据库角色（幂等）"
    if ! dc --profile init run --rm db-init; then
        log "❌ 数据库角色校正失败，回滚环境文件"
        cp -p "${old_env_backup}" "${SHARED_ENV}"
        return 1
    fi

    log "执行数据库迁移"
    if ! dc --profile init run --rm migrate; then
        log "❌ 数据库迁移失败，回滚环境文件"
        cp -p "${old_env_backup}" "${SHARED_ENV}"
        return 1
    fi

    # ---------- 6. 应用 ----------
    log "启动 app / frontend"
    if ! dc up -d --remove-orphans; then
        log "❌ 应用启动失败，回滚"
        cp -p "${old_env_backup}" "${SHARED_ENV}"
        dc up -d --remove-orphans || true
        return 1
    fi

    # ---------- 7. 就绪校验 ----------
    local port url deadline
    port="$(read_env UPSTREAM_PORT)"
    url="http://127.0.0.1:${port}/ready"
    deadline=$(( $(date +%s) + READY_TIMEOUT ))
    log "等待就绪：${url}（最多 ${READY_TIMEOUT}s）"
    while [ "$(date +%s)" -lt "${deadline}" ]; do
        if curl -fsS --max-time 5 "${url}" >/dev/null 2>&1; then
            log "✅ 发布成功：${newrev}"
            log "    回滚方式：cp ${old_env_backup} ${SHARED_ENV} && cd ${WORKTREE} && docker compose --env-file ${SHARED_ENV} -f ${COMPOSE_FILE} up -d"
            return 0
        fi
        sleep "${READY_INTERVAL}"
    done

    log "❌ 就绪检查超时，回滚到上一个版本"
    dc logs --tail 120 app
    cp -p "${old_env_backup}" "${SHARED_ENV}"
    dc up -d --remove-orphans || true
    return 1
}

RESULT=0
DEPLOYED=0
while read -r oldrev newrev refname; do
    if [ "${refname}" != "refs/heads/main" ]; then
        log "跳过非 main 引用：${refname}"
        continue
    fi
    DEPLOYED=1
    deploy "${newrev}" || RESULT=1
done

if [ "${DEPLOYED}" -eq 0 ]; then
    log "本次推送不包含 refs/heads/main，未执行部署"
fi

echo "-------------------------------------------"
if [ "${RESULT}" -eq 0 ]; then
    echo "🟢 发布流程结束：成功"
else
    echo "🔴 发布流程结束：失败（详见 ${LOG_FILE}）"
fi
exit "${RESULT}"