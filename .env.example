# Backend Configuration

# Database (Docker Compose环境使用此配置)
DATABASE_URL=postgresql://admin:admin_password_dev@postgres:5432/knowledge_base

# Redis (Docker Compose环境使用此配置)
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# Qdrant (Docker Compose环境使用此配置)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=rag_documents

# MinIO (Docker Compose环境使用此配置)
MINIO_URL=http://minio:9000
MINIO_CONSOLE_URL=http://minio:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_password_dev
MINIO_BUCKET=knowledge-base

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Security
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (必需配置)
# 选择 LLM 提供商: deepseek, claude, gpt4
LLM_PROVIDER=deepseek

# DeepSeek API (推荐，性价比高)
# 获取 API Key: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ANSWER_MAX_TOKENS=4096
ANSWER_TIMEOUT_SECONDS=90

# Claude API (可选)
# 获取Claude API Key: https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-your-api-key-here
CLAUDE_API_BASE=https://api.sandboxai.top/

# 可选：GPT4 API Key
# GPT4_API_KEY=sk-your-gpt4-key-here

# 模型配置
EMBEDDING_MODEL=BAAI/bge-small-zh
RERANK_MODEL_PATH=/app/models/reranker/models/BAAI--bge-reranker-base/snapshots/master
CLAUDE_MODEL_HAIKU=claude-haiku-4-5-20251001
CLAUDE_MODEL_SONNET=claude-haiku-4-5-20251001

# 功能开关
ENABLE_RERANK=true
ENABLE_AUDIT_LOG=true
ENABLE_CACHE=true

# 方案 B：受控有限状态 RAG Agent（默认关闭，保留 simple 回滚路径）
RAG_AGENT_ENABLED=false
RAG_AGENT_DEFAULT_MODE=simple
RAG_AGENT_MAX_RETRIEVAL_ATTEMPTS=2
RAG_AGENT_RECOVERY_TOP_K=6
RAG_AGENT_MIN_RESULTS=1
# RAG_AGENT_MIN_SCORE=0.0
RAG_AGENT_CLARIFY_ON_MISSING_HOSPITAL=true

# 扫描版 PDF OCR（入库）
PDF_OCR_ENABLED=true
PDF_OCR_LANG=ch
PDF_OCR_DPI=200
PDF_OCR_MIN_CONFIDENCE=0.0
PDF_SCANNED_MIN_CHARS=50
PDF_MAX_UPLOAD_MB=200
